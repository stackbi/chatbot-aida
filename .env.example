# ─── Aïda Chatbot — Variables d'environnement ─────────────────────────────
#
# Copie ce fichier en .env et ajuste les valeurs.
#   cp .env.example .env
#
# En production (Railway, Render, Fly.io), configure ces variables dans les
# paramètres de la plateforme plutôt que dans un fichier .env.

# ─── Authentification admin ──────────────────────────────────────────────
# 🔴 OBLIGATOIRE : mot de passe du tableau de bord (/admin)
# (comparé de façon timing-safe côté serveur)
ADMIN_PASSWORD=votre_mot_de_passe_admin

# ─── Serveur ─────────────────────────────────────────────────────────────
PORT=3000

# ─── Reverse proxy (Railway, Render, Nginx…) ─────────────────────────────
# Derrière un proxy, le rate limiting voit toutes les requêtes comme venant
# du proxy (même IP) → le quota s'épuise en quelques secondes.
# Active le trust proxy pour utiliser la vraie IP du visiteur :
#   TRUST_PROXY=1            (1 saut de proxy, cas le plus courant)
#   TRUST_PROXY=false        (désactive explicitement)
# À activer UNIQUEMENT si le serveur est derrière un proxy de confiance.
TRUST_PROXY=

# ─── CORS ────────────────────────────────────────────────────────────────
# Restreint les domaines autorisés à appeler les routes publiques du widget
# (séparateur virgule). Vide = n'importe quelle origine (multi-sites).
# Exemple : CORS_ORIGINS=https://monsite.com,https://client2.com
CORS_ORIGINS=

# ─── Identification OpenRouter (optionnel mais recommandé) ───────────────
SITE_URL=https://monsite.com

# ─── Anti-veille intégré (Render, Railway… plans gratuits) ──────────────
# URL publique du service (celle que les visiteurs utilisent). Le serveur se
# ping lui-même sur /api/keepalive (réponse 204, ultra-légère) toutes les 5
# minutes : le trafic entrant
# régulier empêche la mise en veille des plans gratuits (Render endort le
# service après ~15 min d'inactivité), sans dépendre d'un cron GitHub Actions
# ni d'un moniteur externe.
# Sur Render, laisser vide est OK : le serveur retombe sur RENDER_EXTERNAL_URL
# (injecté automatiquement) — l'anti-veille est actif dès le Blueprint.
# Autres plateformes : ex. PUBLIC_URL=https://chatbot-aida.onrender.com
PUBLIC_URL=

# Intervalle du self-ping en millisecondes (défaut : 300000 = 5 min).
# N'a aucun effet si PUBLIC_URL est vide.
KEEP_AWAKE_INTERVAL_MS=300000

# ─── Correcteur orthographique (LanguageTool) ────────────────────────────
# Appel externe optionnel sur chaque réponse. Protégé par un fusible
# (circuit breaker) : 2 échecs consécutifs → désactivé 5 min.
SPELLCHECK_ENABLED=true
LANGTOOL_API_URL=https://api.languagetool.org/v2
LANGTOOL_TIMEOUT=1500

# ─── Exploration du site (tests locaux uniquement) ───────────────────────
# Autorise le crawler du mode autonome sur les adresses locales/privées.
# ⚠️ JAMAIS en production (risque SSRF). L'exploration de sites publics
# fonctionne sans cette variable.
ALLOW_LOCAL_SITE_CRAWL=

# ─── Clés API fournisseurs IA ────────────────────────────────────────────
# ⚠️ Les clés API se configurent dans le TABLEAU DE BORD /admin
# (onglet Paramètres), pas dans ce fichier. Elles sont stockées côté
# serveur dans data/store.json et jamais exposées aux visiteurs.
#
# Un seul provider suffit ; les autres servent de fallback automatique :
#   OpenRouter (principal) → Groq (gratuit) → API locale → OpenAI (payant)
