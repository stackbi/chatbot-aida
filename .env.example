# ─── Aïda Chatbot — Variables d'environnement ─────────────────────────────
#
# Copie ce fichier en .env et ajuste les valeurs.
#   cp .env.example .env

# ─── Authentification admin ──────────────────────────────────────────────
# 🔴 OBLIGATOIRE : mot de passe du tableau de bord (/admin)
ADMIN_PASSWORD=votre_mot_de_passe_admin

# ─── Identification OpenRouter (optionnel mais recommandé) ───────────────
SITE_URL=https://monsite.com

# ─── Clés API ────────────────────────────────────────────────────────────
# Au moins l'une d'entre elles doit être configurée pour que le chat fonctionne.
# Les clés sont stockées côté serveur, jamais exposées aux visiteurs.

# OpenRouter (recommandé)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq (fallback gratuit, 14 400 req/jour, Llama 3.3 70B)
# https://console.groq.com/keys
GROQ_API_KEY=

# SiliconFlow (fallback gratuit, DeepSeek/Qwen)
# https://siliconflow.cn/models
SILICONFLOW_API_KEY=

# OpenAI (fallback payant, gpt-4o-mini)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── API personnalisée (fallback local, Ollama/vLLM) ─────────────────────
CUSTOM_API_URL=http://localhost:11434/v1
CUSTOM_API_KEY=
CUSTOM_API_MODEL=llama3.1-8b

# ─── Serveur ─────────────────────────────────────────────────────────────
PORT=3000
