# ─── Aïda Chatbot — Variables d'environnement ─────────────────────────────
#
# Copiez ce fichier en .env et ajustez les valeurs.
#   cp .env.example .env

# Port sur lequel le serveur écoute (défaut: 3000)
PORT=3000

# Mot de passe pour accéder au tableau de bord admin (/admin)
# 🔴 IMPORTANT : Changez ce mot de passe en production !
ADMIN_PASSWORD=votre_mot_de_passe_admin

# URL publique de votre site (utilisée pour identifier votre app dans
# le dashboard OpenRouter). Optionnel mais recommandé.
# SITE_URL=https://monsite.com
